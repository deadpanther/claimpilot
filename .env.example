ANTHROPIC_API_KEY=
# Default model for structured_call() when llm_provider="anthropic" (the
# default provider). Default: claude-sonnet-5. Env-overridable so a
# deployment can pin a different model without a code change -- but see
# claimpilot/config.py's LLM_PRICING comment: pointing this at a model with
# no matching LLM_PRICING entry silently prices every call at $0.
ANTHROPIC_MODEL=
# "anthropic" or "openai" -- selects which Transport backs every LLM call in
# the system (see claimpilot/llm.py's get_transport()). Pre-set to openai
# here so that adding OPENAI_API_KEY below is the only step needed to run
# this; switch to anthropic (and set ANTHROPIC_API_KEY) to use Claude
# instead. Both are fully supported.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Default model for structured_call() when llm_provider="openai". Default:
# gpt-4o. Same env-overridable/LLM_PRICING caveat as ANTHROPIC_MODEL above.
OPENAI_MODEL=
SHIPBOB_API_BASE=
SHIPBOB_API_KEY=
USE_FIXTURES=true
# Per-request timeout (seconds) for the real ShipBob HTTP client, covering
# connect/read/write/pool alike. httpx's own 5s default was part of why the
# free-tier mock's real ReadTimeouts happened as often as they did. Default: 15.0.
SHIPBOB_HTTP_TIMEOUT_SECONDS=

# --- Business-policy thresholds ----------------------------------------------
# Deployment/tuning knobs -- a different environment, a policy update, or a
# cost-model change can override any of these without a code change. Leave
# blank to use the code default shown in each comment (env_ignore_empty=True
# means a blank value here falls back to that default, not to an empty
# string/zero).

# Trailing window (days) a claim must be filed within after delivery to be
# eligible. Default: 30.
CLAIM_WINDOW_DAYS=
# The only Case.sub_category value the eligibility gate treats as an
# in-scope damaged-in-transit claim. Default: "Claim | Damaged in Transit".
ELIGIBLE_SUB_CATEGORY=
# Maximum total reimbursement amount payable for a single claim, in USD.
# Default: 100.00. PRODUCTION POLICY LEVER: overriding this changes the real
# dollar ceiling claimpilot.guard.check_outbound enforces -- treat a change
# here like a code change requiring review, not a casual runtime tweak.
CAP=
# A shipment's declared_value at or above this amount (USD) is flagged as a
# high-value risk factor. Default: 500.00.
HIGH_VALUE_THRESHOLD=
# A merchant with this many or more claims in the trailing 90 days is
# flagged as a high-claim-frequency risk factor. Default: 3.
HIGH_CLAIM_FREQUENCY_THRESHOLD=
# Minimum confidence classify_attachment must report for a classification to
# count toward satisfying a required evidence category. Default: 0.7.
EVIDENCE_MIN_CONF=
# Minimum confidence combine_validation requires, across all four judgments,
# before an all-passed damage validation is allowed to PROCEED rather than
# ESCALATED. Default: 0.75.
VALIDATION_MIN_CONF=

# --- LLM wrapper --------------------------------------------------------------

# Hard wall-clock timeout (seconds) for a single structured_call() transport
# attempt. Default: 30.0.
LLM_TIMEOUT_SECONDS=
# Max output tokens per structured_call() transport attempt. Default: 4096.
LLM_MAX_TOKENS=

# --- Infrastructure / deployment knobs ---------------------------------------

# On-disk SQLite database path. Default: <repo root>/claimpilot.db (an
# absolute path derived from the repo layout -- overriding with a relative
# path here makes it resolve relative to the process's current working
# directory instead).
DB_PATH=
# SSRF allowlist: the only host claimpilot.clients.attachment_guard will
# fetch attachment bytes from. Default:
# sa032101pubdevuc.blob.core.windows.net.
ALLOWED_ATTACHMENT_HOST=
# Hard cap on a single downloaded attachment's size, in bytes. Default:
# 10485760 (10 MiB).
MAX_ATTACHMENT_BYTES=
# Max kind="policy" memory rows retained per (scope, merchant_id) partition
# before the oldest are evicted. Default: 10.
POLICY_NOTE_CAP_PER_PARTITION=
# Trailing window (days) used for merchant claim-frequency counting (risk
# tiering + the drafter's "Claim frequency (last N days)" prompt text).
# NOTE: the underlying field names (claim_frequency_90d,
# claims_last_90_days) still say "90" regardless of this setting -- only a
# naming artifact of the original default, not a behavior bug; see
# config.py's comment on this field for the full explanation. Default: 90.
CLAIM_FREQUENCY_WINDOW_DAYS=
# Read-time cap on how many recent note/correction rows are surfaced to the
# drafter's prompt per merchant. Default: 5.
MAX_RECENT_NOTES=

# --- Live-mock retry policy (clients/retry.py) -------------------------------
# Governs every retry clients/http.py and clients/attachment_guard.py perform
# on a transient network failure (timeout/connection error) or 5xx response
# against the live ShipBob mock. Never retries a 404/422 -- those are real
# answers, not transient failures.

# Max retry attempts after the first (so the default of 3 means up to 4
# total attempts per call). Default: 3.
HTTP_MAX_RETRIES=
# Seconds to wait before the first retry; doubles each subsequent attempt.
# Default: 0.5.
HTTP_RETRY_BASE_DELAY_SECONDS=
# Hard ceiling on the backoff delay, before jitter. Default: 8.0.
HTTP_RETRY_MAX_DELAY_SECONDS=

# --- Review UI access control -------------------------------------------------
# Opt-in HTTP Basic Auth for the whole review UI (every route except
# /health). Active only when BOTH are set -- leaving either blank (the
# default) means NO AUTH, matching this app's original local-dev/demo
# behavior. Set both before exposing this app to anything beyond your own
# machine: with neither set, anyone who can reach the URL can approve
# reimbursements, send emails, or delete policy notes.
REVIEW_UI_USERNAME=
REVIEW_UI_PASSWORD=

# --- Retail-invoice audit -----------------------------------------------------
# Reconcile ShipBob's invoice API against the merchant's submitted retail
# invoice (the order-proof attachment). Costs one extra vision call per case
# that reaches validation; `false` restores the exact pre-audit behavior.
INVOICE_AUDIT_ENABLED=true
INVOICE_PRICE_TOLERANCE=0.01
EXPECTED_CURRENCY=USD

# --- Demo controls ------------------------------------------------------------
# Exposes "Fetch cases" / "Process all" / "Reset all data" in the review UI.
# Set false anywhere that isn't a demo -- the reset button empties every table.
DEMO_CONTROLS_ENABLED=true
